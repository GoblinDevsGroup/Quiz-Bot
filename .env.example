# Telegram
BOT_TOKEN=123456:ABC-DEF_your_bot_token
ADMIN_IDS=123456789,987654321

# Database
DATABASE_URL=postgresql+asyncpg://quizbot:quizbot@postgres:5432/quizbot
DATABASE_URL_SYNC=postgresql+psycopg2://quizbot:quizbot@postgres:5432/quizbot

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_FSM_URL=redis://redis:6379/1

# AI provider (OpenAI-compatible)
AI_PROVIDER=openai
AI_API_KEY=sk-your-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_RETRIES=3
AI_REQUEST_TIMEOUT=120

# PDF processing
PDF_MAX_SIZE_MB=20
PDF_TEMP_DIR=/tmp/quizbot_pdf
OCR_ENABLED=true
TESSERACT_CMD=tesseract

# Rate limiting
RATE_LIMIT_MESSAGES_PER_MINUTE=20
RATE_LIMIT_AI_PER_HOUR=5

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
DEFAULT_LOCALE=uz
